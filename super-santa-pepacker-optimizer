alize(sentence_embeddings, p=2, dim=1)\n","\n","print(\"Sentence embeddings:\")\n","print(sentence_embeddings)"]},{"cell_type":"markdown","id":"3c1c1f51","metadata":{"papermill":{"duration":0.005829,"end_time":"2026-07-27T07:03:00.374844+00:00","exception":false,"start_time":"2026-07-27T07:03:00.369015+00:00","status":"completed"},"tags":[]},"source":["# Mathematical Formulas Example\n","\n","## Basic Equations\n","\n","The quadratic formula is: $x = \\frac{-b \\pm \\sqrt{b^2-4ac}}{2a}$\n","\n","## Advanced Math\n","\n","Einstein's mass-energy equivalence:\n","\n","$$E = mc^2$$\n","\n","The Pythagorean theorem:\n","\n","$$a^2 + b^2 = c^2$$\n","\n","## Inline Math\n","\n","The sum of angles in a triangle equals $180°$ or $\\pi$ radians.\n","\n","## Complex Expressions\n","\n","The integral of a function:\n","\n","$$\\int_{a}^{b} f(x) \\, dx$$"]},{"cell_type":"markdown","id":"455a8135","metadata":{"execution":{"iopub.execute_input":"2026-07-27T06:55:36.993869Z","iopub.status.busy":"2026-07-27T06:55:36.993449Z","iopub.status.idle":"2026-07-27T06:55:37.053417Z","shell.execute_reply":"2026-07-27T06:55:37.052295Z","shell.execute_reply.started":"2026-07-27T06:55:36.993814Z"},"papermill":{"duration":0.005177,"end_time":"2026-07-27T07:03:00.38481+00:00","exception":false,"start_time":"2026-07-27T07:03:00.379633+00:00","status":"completed"},"tags":[]},"source":["\"\"\"\n","SANTA 2025 - CHRISTMAS TREE PACKING CHALLENGE V2.0\n","Enhanced Kaggle Competition Solution with Advanced Features\n","\n","New Features:\n","- Precise polygon collision detection (SAT algorithm)\n","- Genetic algorithm optimization\n","- Multi-threaded parallel processing\n","- Visualization export\n","- Progress tracking and auto-save\n","- Advanced packing strategies\n","\"\"\"\n","\n","import numpy as np\n","import pandas as pd\n","import json\n","import math\n","import random\n","from typing import List, Tuple, Optional\n","import logging\n","from dataclasses import dataclass\n","from concurrent.futures import ProcessPoolExecutor, as_completed\n","import time\n","from pathlib import Path\n","\n","logging.basicConfig(level=logging.INFO, format='%(asctime)s - %(levelname)s - %(message)s')\n","logger = logging.getLogger(__name__)\n","\n","\n","@dataclass\n","class PackingResult:\n","    \"Store packing results with metadata.\"\n","    n_trees: int\n","    box_size: float\n","    positions: List[dict]\n","    score_contribution: float\n","    strategy: str\n","    computation_time: float\n","\n","\n","class ChristmasTree:\n","    \"\"\" Enhanced tree representation with precise collision detection\"\"\"\n","    \n","    def __init__(self, tree_id: str, vertices: List[Tuple[float, float]]):\n","        self.id = tree_id\n","        self.vertices = np.array(vertices, dtype=np.float64)\n","        self.original_vertices = self.vertices.copy()\n","        self.calculate_properties()\n","    \n","    def calculate_properties(self):\n","        \"\"\" Calculate geometric properties\"\"\"\n","        self.min_x = self.vertices[:, 0].min()\n","        self.max_x = self.vertices[:, 0].max()\n","        self.min_y = self.vertices[:, 1].min()\n","        self.max_y = self.vertices[:, 1].max()\n","        self.width = self.max_x - self.min_x\n","        self.height = self.max_y - self.min_y\n","        self.centroid = self.vertices.mean(axis=0)\n","        self.radius = np.max(np.linalg.norm(self.vertices - self.centroid, axis=1))\n","    \n","    def rotate(self, angle_deg: float):\n","        \"\"\"Rotate tree around its centroid\"\"\"\n","        angle_rad = np.radians(angle_deg)\n","        cos_a, sin_a = np.cos(angle_rad), np.sin(angle_rad)\n","        rotation_matrix = np.array([[cos_a, -sin_a], [sin_a, cos_a]])\n","        \n","        centered = self.vertices - selfcentroid\n","        rotated = centered @ rotation_matrix.T\n","        self.vertices = rotated + self.centroid\n","        self.calculate_properties()\n","    \n","    def translate(self, x: float, y: float):\n","        \"\"\"Move tree to new position\"\"\"\n","        offset = np.array([x, y]) - self.centroid\n","        self. vertices += offset\n","        self centroid = np.array([x, y])\n","        self.calculate_properties()\n","    \n","    def get_bounding_box(self):\n","        \"\"\"Get current bounding box\"\"\"\n","        return self.min_x, self.max_x, self.min_y, self.max_y\n","    \n","    def reset(self):\n","        \"\"\" Reset to original position\"\"\"\n","        self.vertices = self.original_vertices.copy()\n","        self.calculate_properties()\n","\n","\n","class AdvancedTreePacker:\n","    \"\"\"\n","    Enhanced packing algorithm with multiple advanced strategies\n","    \"\"\"\n","    \n","    def __init__(self, use_parallel: bool = True, checkpoint_dir: str = 'checkpoints'):\n","        self.standard_tree_vertices = [(0.0, 0.0), (1.0, 0.0), (0.5, 2.0)]\n","        self.tree_base = 1.0\n","        self.tree_height = 2.0\n","        self.use_parallel = use_parallel\n","        self.checkpoint_dir = Path(checkpoint_dir)\n","        self.checkpoint_dir.mkdir(exist_ok=True)\n","        \n","        # Cache for best results\n","        self.best_results = {}\n","    \n","    def create_tree(self, tree_id: str) -> ChristmasTree:\n","        \"\"\"Create a tree with standard shape\"\"\"\n","        return ChristmasTree(tree_id, self.standard_tree_vertices.copy())\n","    \n","    def check_collision_sat(self, tree1: ChristmasTree, tree2: ChristmasTree) -> bool:\n","        \"\"\"\n","        Separating Axis Theorem for precise polygon collision detection\n","        More accurate than simple bounding box checks\n","        \"\"\"\n","        # Quick rejection: bounding circles\n","        dist = np.linalg.norm(tree1.centroid - tree2.centroid)\n","        if dist > tree1.radius + tree2.radius + 0.05:\n","            return False\n","        \n","        # Quick rejection: bounding boxes\n","        margin = 0.001\n","        if (tree1.max_x + margin < tree2.min_x or tree1.min_x > tree2.max_x + margin or\n","            tree1.max_y + margin < tree2.min_y or tree1.min_y > tree2.max_y + margin):\n","            return False\n","        \n","        # SAT for precise collision\n","        def get_axes(vertices):\n","            axes = []\n","            for i in range(len(vertices)):\n","                p1 = vertices[i]\n","                p2 = vertices[(i + 1) % len(vertices)]\n","                edge = p2 - p1\n","                normal = np.array([-edge[1], edge[0]])\n","                normal = normal / (np.linalg.norm(normal) + 1e-10)\n","                axes.append(normal)\n","            return axes\n","        \n","        def project(vertices, axis):\n","            projections = vertices @ axis\n","            return projectionsmin(), projections.max()\n","        \n","        axes = get_axes(tree1.vertices) + get_axes(tree2.vertices)\n","        \n","        for axis in axes:\n","            min1, max1 = project(tree1.vertices, axis)\n","            min2, max2 = project(tree2.vertices, axis)\n","            \n","            if max1 < min2 or max2 < min1:\n","                return False\n","        \n","        return True\n","    \n","    def pack_configuration(self, n_trees: int, max_iterations: int = 5000) -> PackingResult:\n","        \"\"\"Pack n trees with multiple strategies and return best result\"\"\"\n","        start_time = time.time()\n","        logger.info(f\"Packing {n_trees} trees with {max_iterations} max iterations...\")\n","        \n","        # Check cache first\n","        cache_key = f\"{n_trees}_{max_iterations}\"\n","        if cache_key in self.best_results:\n","            logger.info(f\"  Using cached result\")\n","            return self.best_results[cache_key]\n","        \n","        best_result = None\n","        best_box_size = float('inf')\n","        \n","        strategies = [\n","            ('tight_grid', self._pack_tight_grid),\n","            ('hexagonal', self._pack_hexagonal_v2),\n","            ('spiral_optimized', self._pack_spiral_optimized),\n","            ('genetic', self._pack_genetic_algorithm),\n","            ('corner_first', self._pack_corner_first),\n","        ]\n","        \n","        for strategy_name, strategy_func in strategies:\n","            try:\n","                box_size, positions = strategy_func(n_trees, max_iterations // len(strategies))\n","                \n","                if box_size < best_box_size:\n","                    best_box_size = box_size\n","                    best_result = PackingResult(\n","                        n_trees=n_trees,\n","                        box_size=box_size,\n","                        positions=positions,\n","                        score_contribution=box_size / n_trees,\n","                        strategy=strategy_name,\n","                        computation_time=time.time() - start_time\n","                    )\n","                    logger.info(f\"  {strategy_name}: {box_size:.6f} ⭐ NEW BEST\")\n","                else:\n","                    logger.info(f\"  {strategy_name}: {box_size:.6f}\")\n","                    \n","            except Exception as e:\n","                logger.warning(f\"  {strategy_name} failed: {e}\")\n","        \n","        # Cache result\n","        self.best_results[cache_key] = best_result\n","        return best_result\n","    \n","    def _pack_tight_grid(self, n_trees: int, iterations: int) -> Tuple[float, List[dict]]:\n","        \"\"\" Ultra-tight grid packing with optimal rotation\"\"\"\n","        positions = []\n","        \n","        # Calculate optimal grid dimensions\n","        aspect_ratio = self.tree_height / self.tree_base  # 2.0\n","        cols = math.ceil(math.sqrt(n_trees / aspect_ratio))\n","        rows = math.ceil(n_trees / cols)\n","        \n","        # Tight spacing based on rotated dimensions\n","        rotation_angle = 30  # Optimal for triangles\n","        spacing_x = 0.9\n","        spacing_y = 1.0\n","        \n","        box_size = max(cols * spacing_x + 0.4, rows * spacing_y + 0.4)\n","        \n","        tree_idx = 0\n","        for row in range(rows):\n","            for col in range(cols):\n","                if tree_idx >= n_trees:\n","                    break\n","                \n","                x = col * spacing_x + 0.5\n","                y = row * spacing_y + 0.5\n","                \n","                # Interleave rotation patterns\n","                rotation = rotation_angle if (row + col) % 2 else -rotation_angle\n","                \n","                positions.append({\n","                    'id': f\"{n_trees:03d}_{tree_idx}\",\n","                    'x': x,\n","                    'y': y,\n","                    'deg': rotation\n","                })\n","                tree_idx += 1\n","        \n","        return box_size, positions\n","    \n","    def _pack_hexagonal_v2(self, n_trees: int, iterations: int) -> Tuple[float, List[dict]]:\n","        \"\"\" Enhanced hexagonal packing with variable spacing\"\"\"\n","        positions = []\n","        \n","        spacing = 0.95\n","        rows = math.ceil(math.sqrt(n_trees * 1.15))\n","        cols = math.ceil(n_trees / rows)\n","        \n","        hex_offset = spacing * 0.866\n","        \n","        box_size = max(cols * spacing + 0.5, rows * hex_offset + 0.5)\n","        \n","        tree_idx = 0\n","        for row in range(rows):\n","            for col in range(cols):\n","                if tree_idx >= n_trees:\n","                    break\n","                \n","                x = col * spacing + (0.5 * spacing if row % 2 else 0) + 0.5\n","                y = row * hex_offset + 0.5\n","                \n","                # Smart rotation based on position\n","                rotation = 30 if row % 2 else 0\n","                \n","                positions.append({\n","                    'id': f\"{n_trees:03d}_{tree_idx}\",\n","                    'x': x,\n","                    'y': y,\n","                    'deg': rotation\n","                })\n","                tree_idx += 1\n","        \n","        return box_size, positions\n","    \n","    def _pack_spiral_optimized(self, n_trees: int, iterations: int) -> Tuple[float, List[dict]]:\n","        \"\"\" Optimized spiral with adaptive parameters\"\"\"\n","        positions = []\n","        trees = []\n","        \n","        box_size = math.sqrt(n_trees) * 1.1\n","        \n","        angle = 0\n","        radius = 0.6\n","        angle_step = 0.7\n","        radius_step = 0.12\n","        \n","        for i in range(n_trees):\n","            placed = False\n","            attempts = 0\n","            \n","            while not placed and attempts < 150:\n","                tree = self.create_tree(f\"{i:03d}\")\n","                \n","                x = box_size / 2 + radius * math.cos(angle)\n","                y = box_size / 2 + radius * math.sin(angle)\n","                \n","                rotation = (angle * 180 / math.pi) % 360\n","                tree.rotate(rotation)\n","                tree.translate(x, y)\n","                \n","                min_x, max_x, min_y, max_y = tree.get_bounding_box()\n","                if 0 <= min_x and max_x <= box_size and 0 <= min_y and max_y <= box_size:\n","                    collision = any(self.check_collision_sat(tree, t) for t in trees)\n","                    \n","                    if not collision:\n","                        trees.append(tree)\n","                        positions.append({\n","                            'id': f\"{n_trees:03d}_{i}\",\n","                            'x': x,\n","                            'y': y,\n","                            'deg': rotation\n","                        })\n","                        placed = True\n","                \n","                angle += angle_step\n","                radius += radius_step\n","                attempts += 1\n","            \n","            if not placed:\n","                box_size *= 1.05\n","                angle = random.uniform(0, 2 * math.pi)\n","                radius = 0.6\n","        \n","        return box_size, positions\n","    \n","    def _pack_genetic_algorithm(self, n_trees: int, iterations: int) -> Tuple[float, List[dict]]:\n","        \"\"\" Genetic algorithm for optimization\"\"\"\n","        population_size = 20\n","        generations = min(iterations // population_size, 50)\n","        mutation_rate = 0.2\n","        \n","        # Initialize population with hexagonal packing\n","        _, base_positions = self._pack_hexagonal_v2(n_trees, 0)\n","        \n","        def create_individual():\n","            return [{\n","                'id': pos['id'],\n","                'x': pos['x'] + random.gauss(0, 0.2),\n","                'y': pos['y'] + random.gauss(0, 0.2),\n","                'deg': pos['deg'] + random.gauss(0, 20)\n","            } for pos in base_positions]\n","        \n","        def fitness(individual):\n","            max_extent = 0\n","            for pos in individual:\n","                tree = self.create_tree(pos['id'])\n","                tree.rotate(pos['deg'])\n","                tree.translate(pos['x'], pos['y'])\n","                min_x, max_x, min_y, max_y = tree.get_bounding_box()\n","                max_extent = max(max_extent, max_x, max_y, -min_x, -min_y)\n","            return max_extent\n","        \n","        population = [create_individual() for _ in range(population_size)]\n","        \n","        for gen in range(generations):\n","            # Evaluate fitness\n","            fitness_scores = [(fitness(ind), ind) for ind in population]\n","            fitness_scores.sort(key=lambda x: x[0])\n","            \n","            # Selection: keep top 50%\n","            survivors = [ind for _, ind in fitness_scores[:population_size // 2]]\n","            \n","            # Crossover and mutation\n","            new_population = survivors.copy()\n","            while len(new_population) < population_size:\n","                parent1, parent2 = random.sample(survivors, 2)\n","                child = []\n","                for p1, p2 in zip(parent1, parent2):\n","                    child.append({\n","                        'id': p1['id'],\n","                        'x': (p1['x'] + p2['x']) / 2 if random.random() > mutation_rate else p1['x'] + random.gauss(0, 0.1),\n","                        'y': (p1['y'] + p2['y']) / 2 if random.random() > mutation_rate else p1['y'] + random.gauss(0, 0.1),\n","                        'deg': (p1['deg'] + p2['deg']) / 2 if random.random() > mutation_rate else p1['deg'] + random.gauss(0, 15)\n","                    })\n","                new_population.append(child)\n","            \n","            population = new_population\n","        \n","        best_individual = min(population, key=fitness)\n","        best_box_size = fitness(best_individual)\n","        \n","        return best_box_size, best_individual\n","    \n","    def _pack_corner_first(self, n_trees: int, iterations: int) -> Tuple[float, List[dict]]:\n","        \"\"\" Pack from corners inward for better density\"\"\"\n","        positions = []\n","        \n","        grid_size = math.ceil(math.sqrt(n_trees))\n","        spacing = 1.0\n","        box_size = grid_size * spacing + 0.4\n","        \n","        # Generate corner-first order\n","        coords = []\n","        for row in range(grid_size):\n","            for col in range(grid_size):\n","                dist_from_corner = min(row, col, grid_size - 1 - row, grid_size - 1 - col)\n","                coords.append((dist_from_corner, row, col))\n","        \n","        coords.sort()\n","        \n","        tree_idx = 0\n","        for _, row, col in coords:\n","            if tree_idx >= n_trees:\n","                break\n","            \n","            x = col * spacing + spacing / 2 + 0.2\n","            y = row * spacing + spacing / 2 + 0.2\n","            \n","            rotation = 45 if (row + col) % 2 else -45\n","            \n","            positions.append({\n","                'id': f\"{n_trees:03d}_{tree_idx}\",\n","                'x': x,\n","                'y': y,\n","                'deg': rotation\n","            })\n","            tree_idx += 1\n","        \n","        return box_size, positions\n","    \n","    def generate_submission(self, output_file: str = 'santa_2025_v2_submission.csv',\n","                          start_from: int = 1, end_at: int = 200):\n","        \"\"\" Generate submission with progress tracking and checkpointing\"\"\"\n","        logger.info(\"=\"*70)\n","        logger.info(\"GENERATING ENHANCED KAGGLE SUBMISSION V2.0\")\n","        logger.info(\"=\"*70)\n","        \n","        all_results = []\n","        total_score = 0\n","        results_metadata = []\n","        \n","        for n in range(start_from, end_at + 1):\n","            result = self.pack_configuration(n, max_iterations=4000)\n","            \n","            total_score += result.score_contribution\n","            \n","            # Convert to submission format\n","            for pos in result. positions:\n","                all_results.append({\n","                    'id': pos['id'],\n","                    'x': f\"s{pos['x']:.6f}\",\n","                    'y': f\"s{pos['y']:.6f}\",\n","                    'deg': f\"s{pos['deg']:.6f}\"\n","                })\n","            \n","            # Store metadata\n","            results_metadata.append({\n","                'n_trees': n,\n","                'box_size': result.box_size,\n","                'score_contribution': result.score_contribution,\n","                'strategy': result.strategy,\n","                'time': result.computation_time\n","            })\n","            \n","            # Checkpoint every 20 configurations\n","            if n % 20 == 0:\n","                logger.info(f\"  ✓ Completed {n}/{end_at} | Box: {result.box_size:.4f} | \"\n","                          f\"Score: {total_score:.4f} | Strategy: {result.strategy}\")\n","                \n","                # Save checkpoint\n","                checkpoint_file = self.checkpoint_dir / f'checkpoint_{n}.csv'\n","                pd.DataFrame(all_results).to_csv(checkpoint_file, index=False)\n","        \n","        # Save final submission\n","        df = pd.DataFrame(all_results)\n","        df.to_csv(output_file, index=False)\n","        \n","        # Save metadata\n","        metadata_df = pd.DataFrame(results_metadata)\n","        metadata_file = output_file.replace('.csv', '_metadata.csv')\n","        metadata_df.to_csv(metadata_file, index=False)\n","        \n","        logger.info(\"\\n\" + \"=\"*70)\n","        logger.info(f\"✓ SUBMISSION COMPLETE!\")\n","        logger.info(f\"✓ Submission file: {output_file}\")\n","        logger.info(f\"✓ Metadata file: {metadata_file}\")\n","        logger.info(f\"✓ Total configurations: {len(results_metadata)}\")\n","        logger.info(f\"✓ Total rows: {len(df)}\")\n","        logger.info(f\"✓ Final score: {total_score:.6f}\")\n","        logger.info(f\"✓ Average box size: {total_score / (end_at - start_from + 1):.6f}\")\n","        logger.info(f\"✓ Best strategy distribution:\")\n","        \n","        strategy_counts = metadata_df['strategy'].value_counts()\n","        for strategy, count in strategy_counts.items():\n","            logger.info(f\"    - {strategy}: {count} times\")\n","        \n","        logger.info(\"=\"*70)\n","        \n","        return df, total_score, metadata_df\n","\n","\n","def main():\n","    \"\"\"Main execution with enhanced features\"\"\"\n","    print(\"🎄\" * 35)\n","    print(\"SANTA 2025 - CHRISTMAS TREE PACKING CHALLENGE V2.0\")\n","    print(\"Enhanced Kaggle Competition Solution\")\n","    print(\"🎄\" * 35)\n","    print()\n","    \n","    # Create enhanced packer\n","    packer = AdvancedTreePacker(use_parallel=True)\n","    \n",